{
  "manifest_version": 3,
  "name": "SonicT Daily Reporter",
  "version": "0.1.0",
  "description": "依次打开报表页面，自动登录并嗅探昨日经营数据与核心指标。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "日报导出"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
